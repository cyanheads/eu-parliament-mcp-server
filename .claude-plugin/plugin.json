{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "eu-parliament-mcp-server",
  "version": "0.1.1",
  "description": "Track European Parliament procedures, MEPs, votes, documents, speeches, and questions via MCP. STDIO or Streamable HTTP.",
  "author": {
    "name": "cyanheads",
    "email": "casey@caseyjhand.com",
    "url": "https://github.com/cyanheads"
  },
  "homepage": "https://github.com/cyanheads/eu-parliament-mcp-server#readme",
  "repository": "https://github.com/cyanheads/eu-parliament-mcp-server",
  "license": "Apache-2.0",
  "keywords": ["mcp", "mcp-server", "model-context-protocol", "ai-agents", "ai-tools", "typescript", "bun", "stdio", "streamable-http", "cyanheads", "european-parliament", "european-union", "legislation", "roll-call-votes", "meps", "open-data"],
  "mcpServers": {
    "eu-parliament-mcp-server": {
      "command": "npx",
      "args": ["-y", "@cyanheads/eu-parliament-mcp-server"],
      "env": {
        "MCP_TRANSPORT_TYPE": "stdio"
      }
    }
  }
}
